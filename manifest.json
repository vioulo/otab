{
    "manifest_version": 3,
    "name": "Otab",
    "version": "0.3.2",
    "description": "__MSG_extensionDescription__",
    "default_locale": "zh_CN",
    "browser_specific_settings": {
        "gecko": {
            "id": "firefox-otab@void.gold",
            "strict_min_version": "109.0"
        }
    },
    "background": {
        "scripts": [
            "js/pinstore.js",
            "js/background.js"
        ]
    },
    "action": {
        "default_popup": "pages/popup.html",
        "default_icon": {
            "32": "imgs/icons/icon32.png",
            "48": "imgs/icons/icon48.png",
            "96": "imgs/icons/icon96.png",
            "128": "imgs/icons/icon96.png"
        },
        "default_title": "Otab"
    },
    "icons": {
        "32": "imgs/icons/icon32.png",
        "48": "imgs/icons/icon48.png",
        "96": "imgs/icons/icon96.png",
        "128": "imgs/icons/icon96.png"
    },
    "chrome_url_overrides": {
        "newtab": "pages/new-tab.html"
    },
    "chrome_settings_overrides": {
        "homepage": "pages/new-tab.html"
    },
    "options_ui": {
        "page": "pages/setting.html",
        "open_in_tab": true
    },
    "permissions": [
        "bookmarks",
        "storage",
        "contextMenus",
        "tabs",
        "notifications"
    ]
}
